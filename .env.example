# 6FIGS.XYZ frontend env — copy to .env and adjust. Both vars ship with local
# dev defaults.
#
# NEXT_PUBLIC_API_URL    Backend base URL (default http://localhost:4000).
# NEXT_PUBLIC_CHAIN_MODE devnet | prod — must match the backend CHAIN_MODE.
#                        Devnet hides the BTC tab (Sepolia + Solana devnet only).
#
# PORT                   Web port honored by both `yarn dev` and `yarn start`.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_MODE=devnet
PORT=3000
