# 6FIGS.XYZ frontend env — copy to .env and adjust. Both vars ship with local
# dev defaults.
#
# NEXT_PUBLIC_API_URL    Backend base URL (default http://localhost:4000).
# NEXT_PUBLIC_CHAIN_MODE devnet | prod — must match the backend CHAIN_MODE.
#                        Devnet hides the BTC tab (Sepolia + Solana devnet only).
#
# NEXT_PUBLIC_ENCLAVE_URL   Enclave base URL for tee proofs.
# NEXT_PUBLIC_IMAGE_DIGEST  Pinned workload digest (sha256:...), comma list.
# NEXT_PUBLIC_GCP_PROJECT   Pinned GCP project id, comma list.
#                           All three are required for the prove flow; the app
#                           fails closed without them.
# NEXT_PUBLIC_REQUIRED_ESCROW_KEY_PROVIDERS  Providers the client will accept,
#                           e.g. "kms". Empty = any attested provider.
#
# PORT                   Web port honored by both `yarn dev` and `yarn start`.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_MODE=devnet
NEXT_PUBLIC_ENCLAVE_URL=
NEXT_PUBLIC_IMAGE_DIGEST=
NEXT_PUBLIC_GCP_PROJECT=
NEXT_PUBLIC_REQUIRED_ESCROW_KEY_PROVIDERS=
PORT=3000
